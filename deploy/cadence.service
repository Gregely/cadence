# systemd unit for running Cadence on a Raspberry Pi (or any Linux).
# Install: see README "Raspberry Pi with systemd".
[Unit]
Description=Cadence writing notebook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cadence
Group=cadence
WorkingDirectory=/opt/cadence
Environment=CADENCE_DB=/var/lib/cadence/cadence.sqlite3
Environment=CADENCE_BACKUP_DIR=/var/lib/cadence/backups
Environment=CADENCE_HOST=127.0.0.1
Environment=CADENCE_PORT=8765
ExecStart=/opt/cadence/.venv/bin/python -m cadence
Restart=on-failure
RestartSec=3

# Hardening: the app only needs its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/cadence
StateDirectory=cadence
StateDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
